{
  "name": "system-design-07-unique-id-generator",
  "version": "0.1.0",
  "description": "Crash-fenced 64-bit time-sortable ID generator with explicit clock and worker-lease boundaries",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js",
    "recover-lock": "node scripts/recover-lock.mjs",
    "lint": "node scripts/repo-check.mjs",
    "test": "node --test --test-reporter=spec",
    "smoke": "node scripts/runtime-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm test && npm run smoke && npm run benchmark && npm run audit"
  },
  "keywords": [
    "system-design",
    "snowflake-id",
    "distributed-id",
    "clock-fence",
    "idempotency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estelledc/system-design-07-unique-id-generator.git"
  },
  "bugs": {
    "url": "https://github.com/estelledc/system-design-07-unique-id-generator/issues"
  },
  "homepage": "https://github.com/estelledc/system-design-07-unique-id-generator#readme",
  "license": "MIT"
}
